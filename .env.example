# Runtime (server.mjs)
PORT=8080
# Form delivery via Resend (https://resend.com). Without a key, forms show the error state.
RESEND_API_KEY=
FORM_TO=ctagronomy@gmail.com
# Must be a sender on a Resend-verified domain in production
FORM_FROM=CTA Website <onboarding@resend.dev>
# Build time (optional): post forms to a different handler instead of /api/form
# PUBLIC_FORM_ENDPOINT=
