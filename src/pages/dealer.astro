---
import Img from '../components/Img.astro';
import Base from '../layouts/Base.astro';
import { APPLY_STEPS, DEALER_STEPS, DEALER_GET, DEALER_WHO } from '../data/site.mjs';
---
<Base title="Become a dealer" description="Carry a line built on agronomy rather than commodity blends. Now appointing founding dealers." nosidetab>
  <section class="wrap stack" style="padding-top:64px;gap:96px">
    <div class="stack" style="gap:36px">
      <div class="g2">
        <h1 class="h-page">Become a <em>CTA dealer.</em></h1>
        <p class="lede">Carry a line built on agronomy rather than commodity blends. Dealers get program support, technical backing on tank mixes and rates, and a product set that sells on results.</p>
      </div>
      <div class="ph dots fx"><Img src="/assets/result-goalpost.jpg" alt="Football field with goalpost and press box" loading="eager" sizes="(min-width:1280px) 1216px, 100vw" style="aspect-ratio:21/9;object-position:center 40%" /></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:48px">
      {DEALER_STEPS.map((s) => (
        <div class="stack" style="gap:12px"><span class="numeral" data-count>{s.n}</span><h3 style="font-size:30px;font-weight:600">{s.t}</h3><p class="muted">{s.b}</p></div>
      ))}
    </div>
    <div class="stack" style="gap:32px">
      <h2 class="h-sec">What Partners Receive</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:36px 48px">
        {DEALER_GET.map((d) => <div class="stack" style="gap:8px"><h3 style="font-size:24px;font-weight:600">{d.t}</h3><p style="font-size:17px" class="muted">{d.b}</p></div>)}
      </div>
    </div>
    <div class="stack" style="gap:20px">
      <h2 class="h-sec">Who We Work With</h2>
      <p style="font-size:24px;font-style:italic;max-width:900px">{DEALER_WHO}</p>
    </div>
    <div id="apply" class="g2 s" style="gap:56px 80px">
      <div class="stack" style="gap:32px">
        <div class="stack" style="gap:16px">
          <span class="kicker m">Founding dealers</span>
          <h2 class="h-sec">Now appointing our <em>first dealers.</em></h2>
          <p style="font-size:19px">The CTA dealer network is new. We are building it territory by territory with a small group of founding partners who know their local turf market.</p>
        </div>
        <div class="stack" style="gap:14px">
          {APPLY_STEPS.map((a) => (
            <div style="display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:baseline">
              <span style="font-size:28px;font-weight:600;color:var(--color-accent)">{a.n}</span>
              <div class="stack" style="gap:2px"><span style="font-size:22px;font-weight:600">{a.t}</span><span style="font-size:17px" class="muted">{a.b}</span></div>
            </div>
          ))}
        </div>
        <div class="stack" style="gap:6px">
          <span class="kicker n">Dealer contact</span>
          <span style="font-size:32px;font-weight:600;line-height:1.1">Brent Smith</span>
          <span style="font-size:18px">215 E 2nd Street, Dewitt, IA 52742</span>
          <span style="font-size:18px"><a href="tel:5632101616">563-210-1616</a> · <a href="mailto:ctagronomy@gmail.com">ctagronomy@gmail.com</a></span>
        </div>
        <div class="stack" style="gap:8px">
          <h3 style="font-size:24px;font-weight:600">Looking for a dealer near you?</h3>
          <p style="font-size:17px" class="muted">While the network is being built, CTA sells direct. <a href="/contact" data-open-quote>Request a quote</a> and we will ship to you or connect you with your nearest dealer.</p>
        </div>
      </div>
      <div data-form-root="dealer">
        <form class="form" data-form="dealer" method="post" action="/dealer" novalidate>
          <h3 style="font-size:28px;font-weight:600">Dealer application</h3>
          <div class="form-err" role="alert" hidden data-err>Your application didn’t send. Check your connection and try again, or email <a href="mailto:ctagronomy@gmail.com">ctagronomy@gmail.com</a>.</div>
          <div class="field-grid">
            <label class="field">Name *<input class="input" name="fullname" autocomplete="name"><span class="err" hidden></span></label>
            <label class="field">Company *<input class="input" name="company" autocomplete="organization"><span class="err" hidden></span></label>
            <label class="field">Email *<input class="input" name="email" type="email" autocomplete="email"><span class="err" hidden></span></label>
            <label class="field">Phone<input class="input" name="phone" type="tel" autocomplete="tel"></label>
          </div>
          <label class="field">Territory you want to cover *<input class="input" name="territory" placeholder="e.g. Eastern Iowa, Quad Cities"><span class="err" hidden></span></label>
          <label class="field">Your customers are mostly
            <select class="input" name="customers"><option>Golf courses</option><option>Sports turf</option><option>Lawn care &amp; landscape</option><option>Sod farms</option><option>A mix</option></select>
          </label>
          <label class="field">Lines you carry today<textarea class="input" name="message" rows="4" style="resize:vertical"></textarea></label>
          <div class="hp" aria-hidden="true"><label>Leave blank<input name="website" tabindex="-1" autocomplete="off"></label></div>
          <button type="submit" class="btn btn-primary btn-submit" data-submit data-label="Submit application">Submit application</button>
        </form>
        <div class="form-ok" role="status" hidden data-ok>
          <span class="kicker">Application received</span>
          <h2 style="font-size:clamp(32px,3.6vw,48px);font-weight:600;letter-spacing:-.02em">Thank you. Brent will call to talk territory.</h2>
          <p style="font-size:19px">A confirmation is on its way to <span data-email></span>. Questions in the meantime: <a href="tel:5632101616">563-210-1616</a>.</p>
          <button type="button" class="btn btn-secondary btn-ink" style="min-height:44px" data-reset>Submit another application</button>
        </div>
      </div>
    </div>
  </section>
</Base>
