---
import '../styles/broadsheet.css';
import '../styles/site.css';
import { NAV, SITE, SUGGEST } from '../data/site.mjs';
import QuoteForm from '../components/QuoteForm.astro';

const { title, description = SITE.description, active = '', noindex = false, ogImage = '/assets/result-fairway-sun.jpg', nosidetab = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, SITE.url).href;
const fullTitle = title ? `${title} | Central Turf Agronomy` : 'Central Turf Agronomy | High Performance. Max Returns.';
const isActive = (href) => (href === '/' ? path === '/' : active ? active === href : path === href || path.startsWith(href + '/'));
---
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL(ogImage, SITE.url).href}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
  <link rel="apple-touch-icon" href="/assets/favicon-180.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
  <slot name="head" />
</head>
<body data-nosidetab={nosidetab ? '' : undefined}>
<div class="page" style="min-height:100vh">
  <header class="site-header">
    <div class="wrap" style="padding-top:14px">
      <div class="hdr-row">
        <a href="/" class="brand"><img src="/assets/cta-logo.png" alt="Central Turf Agronomy" width="48" height="48"><span>Central Turf Agronomy</span></a>
        <nav class="nav-d" aria-label="Primary">
          {NAV.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="btn btn-ghost hdr-search" data-open-search aria-label="Search the site">Search <span class="kbd">/</span></button>
        <a href="/contact" class="btn btn-primary hdr-quote" data-open-quote>Request a Quote</a>
        <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="site-drawer" data-menu-toggle><span></span><span></span><span></span></button>
      </div>
      <div class="dateline"><a href="/assets/CTA-Catalog-2026.pdf" target="_blank" rel="noopener" data-open-catalog aria-haspopup="dialog">Product Catalog · 2026</a><a href="tel:5632101616">563-210-1616 · Dewitt, IA</a></div>
    </div>
  </header>

  <div class="scrim" data-menu-close aria-hidden="true"></div>
  <aside id="site-drawer" class="drawer" aria-label="Site menu">
    <div class="drawer-bg" aria-hidden="true"></div>
    <div class="drawer-top">
      <span class="kicker">Menu</span>
      <button class="xbtn" aria-label="Close menu" data-menu-close><span></span><span></span></button>
    </div>
    <div class="drawer-search"><div><input type="search" placeholder="Search products, nutrients…" aria-label="Search the site" data-drawer-q></div></div>
    <div class="drawer-body" data-drawer-body>
      <nav class="drawer-links" aria-label="Menu">
        {NAV.map((n, i) => <a href={n.href} style={`--i:${i}`} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="drawer-foot">
        <a href="/contact" class="btn btn-primary" style="min-height:48px" data-open-quote>Request a Quote</a>
        <a href="tel:5632101616" style="font-size:18px">563-210-1616</a>
      </div>
      <div data-drawer-results></div>
    </div>
  </aside>

  <div class="search-ov" role="dialog" aria-modal="true" aria-label="Search" hidden data-search>
    <div class="search-in">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:16px">
        <span class="kicker" style="color:var(--color-text)">Search Central Turf Agronomy</span>
        <button class="btn btn-secondary btn-ink" style="min-height:44px" data-close-search>Close</button>
      </div>
      <div class="search-bar"><input type="search" placeholder="Products, ingredients, programs…" aria-label="Search" data-search-q></div>
      <div class="suggest" data-suggest><span class="kicker n">Try</span>{SUGGEST.map((s) => <button type="button" data-suggest-q={s}>{s}</button>)}</div>
      <div data-search-results></div>
    </div>
  </div>

  <main style="flex:1" id="main"><slot /></main>

  <footer class="wrap foot" style="width:100%">
    <div class="foot-rule"></div>
    <div class="foot-in">
      <div class="stack" style="flex:1 1 340px;max-width:460px;gap:16px">
        <img src="/assets/cta-logo.png" alt="Central Turf Agronomy" height="72" style="height:72px;width:auto;align-self:flex-start">
        <p style="font-size:16px">{SITE.tagline}</p>
        <p style="font-size:16px"><a href="tel:5632101616">563-210-1616</a> · <a href="mailto:ctagronomy@gmail.com">ctagronomy@gmail.com</a></p>
      </div>
      <nav aria-label="Footer">{NAV.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
    </div>
    <p style="margin-top:40px;font-size:13px;letter-spacing:.14em;text-transform:uppercase">High Performance. Max Returns.</p>
  </footer>

  <a href="/contact" class="btn btn-primary sidetab" data-open-quote aria-haspopup="dialog">Request a Quote</a>

  <dialog class="quote" aria-labelledby="quote-title" data-quote>
    <div class="stack" style="gap:20px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px">
        <div class="stack" style="gap:6px">
          <span class="kicker">Central Turf Agronomy</span>
          <h2 id="quote-title" style="font-size:clamp(32px,4vw,44px);font-weight:600;letter-spacing:-.02em">Request a quote.</h2>
        </div>
        <button class="btn btn-ghost" style="min-width:44px;min-height:44px;font-size:16px" data-close-quote>Close</button>
      </div>
      <p style="font-size:17px" class="muted">Program guidance, custom timing or volume pricing. Or call <a href="tel:5632101616">563-210-1616</a>.</p>
      <QuoteForm kind="quote" rows={4} />
    </div>
  </dialog>
  <dialog class="catalog" aria-label="Product Catalog 2026" data-catalog>
    <div class="catalog-bar">
      <span class="kicker" style="color:var(--color-text)">Product Catalog · 2026</span>
      <span style="display:flex;gap:10px;align-items:center">
        <a href="/assets/CTA-Catalog-2026.pdf" target="_blank" rel="noopener" class="btn btn-secondary btn-ink" style="min-height:44px">Open in new tab</a>
        <button class="btn btn-ghost" style="min-height:44px;font-size:16px" data-close-catalog>Close</button>
      </span>
    </div>
    <iframe title="Product Catalog 2026 (PDF)" data-catalog-frame></iframe>
  </dialog>
</div>
<script>import '../scripts/site.js';</script>
</body>
</html>
